          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails du partage sont en cours de synchronisation. Réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles del uso compartido se están sincronizando. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
