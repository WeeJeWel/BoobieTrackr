    "Open a new feeding for the selected baby.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een nieuwe voeding voor de geselecteerde baby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Mahlzeit für das ausgewählte Baby öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir une nouvelle tétée pour le bébé sélectionné."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir una nueva toma para el bebé seleccionado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una nuova poppata per il bebè selezionato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir uma nova mamada para o bebê selecionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为所选宝宝打开新增喂奶页面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中の赤ちゃんの授乳入力画面を開きます。"
          }
        }
      }
    },
    "Enter a valid amount (0–10,000 ml) or duration (0–1,440 min). Your last valid value is still saved.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul een geldige hoeveelheid (0–10.000 ml) of duur in hele minuten (0–1.440 min) in. Je laatste geldige waarde blijft bewaard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine gültige Menge (0–10.000 ml) oder ganze Minuten (0–1.440 Min.) ein. Der letzte gültige Wert bleibt gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une quantité valide (0–10 000 ml) ou une durée en minutes entières (0–1 440 min). La dernière valeur valide reste enregistrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una cantidad válida (0–10.000 ml) o minutos enteros (0–1.440 min). El último valor válido sigue guardado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una quantità valida (0–10.000 ml) o minuti interi (0–1.440 min). L’ultimo valore valido resta salvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira uma quantidade válida (0–10.000 ml) ou minutos inteiros (0–1.440 min). O último valor válido continua salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效奶量（0–10,000 毫升）或整数分钟（0–1,440 分钟）。上次有效值仍已保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な量（0〜10,000 ml）または整数の時間（0〜1,440分）を入力してください。前回の有効な値は保存されています。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid amount (0–10,000 ml) or whole minutes (0–1,440 min). Your last valid value is still saved."
          }
        }
      }
    },
    "Enter a baby name. The previous name is still saved.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul een babynaam in. De vorige naam blijft bewaard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Babynamen ein. Der bisherige Name bleibt gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un prénom. Le prénom précédent reste enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre. El nombre anterior sigue guardado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome. Il nome precedente resta salvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um nome. O nome anterior continua salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入宝宝姓名。原姓名仍已保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤ちゃんの名前を入力してください。以前の名前は保存されています。"
          }
        }
      }
    },
    "This permanently deletes %@ and all their feedings, including for anyone sharing this baby’s journal.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee verwijder je %@ en alle voedingen definitief, ook voor iedereen met wie je dit dagboek deelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden %@ und alle Mahlzeiten dauerhaft gelöscht, auch für alle, die dieses Tagebuch teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement %@ et toutes ses tétées, y compris pour les personnes partageant ce journal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente a %@ y todas sus tomas, también para quienes comparten este diario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina definitivamente %@ e tutte le poppate, anche per chi condivide questo diario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente %@ e todas as mamadas, inclusive para quem compartilha este diário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除%@及其所有喂奶记录，所有共享此日志的人也将无法查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@とすべての授乳記録が完全に削除されます。この日記を共有している全員に反映されます。"
          }
        }
      }
    },
    "The feeding journal couldn’t be opened. Please restart the app and try again.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het voedingsdagboek kon niet worden geopend. Start de app opnieuw en probeer het nog eens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tagebuch konnte nicht geöffnet werden. Starte die App neu und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le journal. Redémarrez l’app et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el diario. Reinicia la app e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il diario. Riavvia l’app e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o diário. Reinicie o app e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开喂养日志。请重启 App 后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "授乳日記を開けませんでした。アプリを再起動して、もう一度お試しください。"
          }
        }
      }
    },
    "Enter a volume between 0 and 10,000 ml.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
