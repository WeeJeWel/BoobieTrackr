    "Save this duration and immediately start the other breast.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla deze duur op en start meteen de andere borst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dauer speichern und sofort die andere Brust starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
