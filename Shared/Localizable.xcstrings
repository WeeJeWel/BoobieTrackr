    },
    "Invite your partner to this baby’s journal. Everyone invited can rename the baby and add, edit, or delete feedings.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig je partner uit voor dit voedingsdagboek. Iedereen die is uitgenodigd kan de babynaam wijzigen en voedingen toevoegen, bewerken of verwijderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade deinen Partner zu diesem Tagebuch ein. Alle Eingeladenen können den Babynamen ändern und Mahlzeiten hinzufügen, bearbeiten oder löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez votre partenaire à ce journal. Chaque personne invitée peut renommer le bébé et ajouter, modifier ou supprimer des tétées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a tu pareja a este diario. Todos los invitados pueden cambiar el nombre del bebé y añadir, editar o eliminar tomas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita il partner a questo diario. Chiunque sia invitato può rinominare il bebè e aggiungere, modificare o eliminare poppate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convide seu parceiro para este diário. Todos os convidados podem alterar o nome do bebê e adicionar, editar ou excluir mamadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请伴侣共享宝宝的日志。所有受邀者都可以更改宝宝姓名，以及添加、编辑或删除喂奶记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーをこの日記に招待しましょう。招待された全員が、赤ちゃんの名前の変更や授乳記録の追加・編集・削除を行えます。"
          }
        }
      }
    },
    "Sharing needs a signed build with iCloud enabled. Demo data stays on this device.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delen vereist een ondertekende app met iCloud ingeschakeld. Demogegevens blijven op dit apparaat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Teilen ist eine signierte App mit aktiviertem iCloud erforderlich. Demodaten bleiben auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage nécessite une app signée avec iCloud activé. Les données de démonstration restent sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para compartir se necesita una app firmada con iCloud activado. Los datos de prueba permanecen en este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione richiede un’app firmata con iCloud attivo. I dati demo restano su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento requer um app assinado com iCloud ativado. Os dados de demonstração ficam neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享需要已签名且启用 iCloud 的 App。演示数据仅保存在此设备上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有にはiCloudを有効にした署名済みアプリが必要です。デモデータはこのデバイスにのみ保存されます。"
          }
        }
      }
    },
    "Feedings are saved on your device immediately and sync through iCloud when connected. Accept your partner’s invitation on your iPhone; the shared journal also syncs to your Watch.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voedingen worden direct op je apparaat opgeslagen en via iCloud gesynchroniseerd zodra je verbonden bent. Accepteer de uitnodiging van je partner op je iPhone; het gedeelde dagboek verschijnt ook op je Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahlzeiten werden sofort auf deinem Gerät gespeichert und bei bestehender Verbindung über iCloud synchronisiert. Nimm die Einladung auf deinem iPhone an; das geteilte Tagebuch wird auch mit deiner Watch synchronisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tétées sont enregistrées immédiatement sur votre appareil et synchronisées via iCloud dès qu’une connexion est disponible. Acceptez l’invitation sur votre iPhone ; le journal partagé se synchronise aussi sur votre Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tomas se guardan al instante en tu dispositivo y se sincronizan por iCloud cuando hay conexión. Acepta la invitación de tu pareja en tu iPhone; el diario compartido también se sincroniza con tu Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poppate vengono salvate subito sul dispositivo e sincronizzate tramite iCloud quando sei connesso. Accetta l’invito del partner su iPhone; il diario condiviso si sincronizza anche su Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mamadas são salvas imediatamente no dispositivo e sincronizadas pelo iCloud quando há conexão. Aceite o convite no iPhone; o diário compartilhado também sincroniza com o Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喂奶记录会立即保存在设备上，并在联网时通过 iCloud 同步。请在 iPhone 上接受伴侣的邀请；共享日志也会同步到 Watch。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "授乳記録はすぐにデバイスに保存され、接続時にiCloud経由で同期されます。パートナーの招待はiPhoneで承認してください。共有日記はWatchにも同期されます。"
          }
        }
      }
    },
    "Feeding saved. The Lock Screen timer couldn’t start: %@": {
      "extractionState": "manual",
