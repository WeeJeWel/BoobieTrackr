    "Shared iCloud storage isn’t available yet. Please try the invitation again.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedeelde iCloud-opslag is nog niet beschikbaar. Probeer de uitnodiging opnieuw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geteilte iCloud-Speicher ist noch nicht verfügbar. Öffne die Einladung erneut."
          }
        },
        "fr": {
